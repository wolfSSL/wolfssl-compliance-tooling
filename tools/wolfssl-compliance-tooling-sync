#!/usr/bin/env python3
"""wolfssl-compliance-tooling-sync - vendor the wolfssl-compliance-tooling share/ set into a product repository.

This is the standard distribution method for products that wolfSSL owns. It
copies the controlled share/ files into a product at a fixed path (tools/sbom/
by default) and writes the toolkit pin files (VERSION and .wolfssl-compliance-tooling-rev) next
to them. It uses no network and no git submodule, so it works on air-gapped
hosts and does not break source tarballs (see PLAN.md sections 10 and 16).

Usage:
  wolfssl-compliance-tooling-sync --dest /path/to/product [options]

Options:
  --dest PATH     Product repository root (required).
  --subdir NAME   Vendored path inside the product. Default: tools/sbom.
  --src PATH      wolfssl-compliance-tooling repository root. Default: derived from this script.
  --check         Do not copy. Report drift and exit non-zero if any file
                  differs. Use this in a product's CI drift check.
"""

import argparse
import filecmp
import os
import shutil
import subprocess
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_SRC = os.path.dirname(SCRIPT_DIR)  # repo root (tools/ is under it)


def iter_share_files(share_dir):
    for root, dirs, files in os.walk(share_dir):
        dirs[:] = [d for d in dirs if d != "__pycache__"]
        for name in files:
            if name.endswith((".pyc", ".pyo")):
                continue
            full = os.path.join(root, name)
            yield full, os.path.relpath(full, share_dir)


def is_inside(base, path):
    """True if absolute path equals base or lies beneath it."""
    return os.path.commonpath([base, path]) == base


def source_revision(src_root):
    """Return the source git revision if available, else an empty string."""
    try:
        res = subprocess.run(
            ["git", "-C", src_root, "rev-parse", "HEAD"],
            capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError):
        return ""
    return res.stdout.strip()


def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dest", required=True)
    ap.add_argument("--subdir", default="tools/sbom")
    ap.add_argument("--src", default=DEFAULT_SRC)
    ap.add_argument("--check", action="store_true")
    args = ap.parse_args()

    share_dir = os.path.join(args.src, "share")
    version_file = os.path.join(args.src, "VERSION")
    source_rev = source_revision(args.src)
    if not os.path.isdir(share_dir):
        sys.exit(f"ERROR: no share/ directory at {share_dir}")

    # --subdir is joined onto --dest and then written into. An absolute value
    # (os.path.join discards --dest) or one containing .. would place and
    # overwrite files outside the product's vendoring path, so require it to
    # resolve to a location inside --dest.
    if os.path.isabs(args.subdir):
        sys.exit(f"ERROR: --subdir must be relative to --dest, got absolute "
                 f"{args.subdir!r}.")
    dest_root = os.path.join(args.dest, args.subdir)
    dest_abs = os.path.realpath(args.dest)
    dest_root_abs = os.path.realpath(dest_root)
    if not is_inside(dest_abs, dest_root_abs):
        sys.exit(f"ERROR: --subdir {args.subdir!r} escapes --dest; it must "
                 f"resolve to a path inside {args.dest!r}.")
    files = sorted(iter_share_files(share_dir), key=lambda p: p[1])

    if args.check:
        drift = []
        for src, rel in files:
            dst = os.path.join(dest_root, rel)
            if not os.path.isfile(dst) or not filecmp.cmp(src, dst, shallow=False):
                drift.append(rel)
        if os.path.isfile(version_file):
            dst_v = os.path.join(dest_root, "VERSION")
            if not os.path.isfile(dst_v) or not filecmp.cmp(
                    version_file, dst_v, shallow=False):
                drift.append("VERSION")
        if source_rev:
            dst_r = os.path.join(dest_root, ".wolfssl-compliance-tooling-rev")
            if not os.path.isfile(dst_r):
                drift.append(".wolfssl-compliance-tooling-rev")
            else:
                with open(dst_r, encoding="utf-8", errors="replace") as f:
                    if f.read().strip() != source_rev:
                        drift.append(".wolfssl-compliance-tooling-rev")
        if drift:
            print("DRIFT: vendored wolfssl-compliance-tooling files differ from share/:",
                  file=sys.stderr)
            for rel in drift:
                print(f"  {rel}", file=sys.stderr)
            print("Re-run wolfssl-compliance-tooling-sync to update.", file=sys.stderr)
            sys.exit(1)
        print("OK: vendored wolfssl-compliance-tooling files match share/.")
        return

    # A symlink already present under dest_root (a file, or a directory on
    # the way to one) would redirect a write outside it. Resolve every target
    # before writing anything and refuse if one leaves dest_root.
    targets = [rel for _, rel in files]
    if os.path.isfile(version_file):
        targets.append("VERSION")
    if source_rev:
        targets.append(".wolfssl-compliance-tooling-rev")
    for rel in targets:
        if not is_inside(dest_root_abs,
                         os.path.realpath(os.path.join(dest_root, rel))):
            sys.exit(f"ERROR: {rel!r} under {dest_root!r} resolves outside "
                     f"it through a symlink; refusing to write.")

    count = 0
    for src, rel in files:
        dst = os.path.join(dest_root, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)
        count += 1
    if os.path.isfile(version_file):
        shutil.copy2(version_file, os.path.join(dest_root, "VERSION"))
    if source_rev:
        with open(os.path.join(dest_root, ".wolfssl-compliance-tooling-rev"), "w",
                  encoding="utf-8") as f:
            f.write(source_rev + "\n")
    print(f"Synced {count} file(s) into {dest_root}")
    if source_rev:
        print(f"Pinned wolfssl-compliance-tooling revision: {source_rev}")
    print("Commit the vendored files, VERSION, and .wolfssl-compliance-tooling-rev.")


if __name__ == "__main__":
    main()
