#!/usr/bin/env python3
"""Assemble a CSAF 2.0 *directory-based* distribution from generated CSAF docs.

`gen-advisory` emits the advisory *bodies* (`<id>.csaf.json`). To become a CSAF
Trusted Provider you must also publish, for every document:

  * a SHA-256 and a SHA-512 hash file,
  * a detached OpenPGP signature (`.asc`),

and, at the distribution root:

  * `provider-metadata.json` (the discovery file + signing-key fingerprint),
  * `index.txt`   (every document path, one per line),
  * `changes.csv` ("path",iso-timestamp, newest first),
  * `openpgp-key.asc` (the public signing key).

This tool takes the `advisories/out/` directory and lays out a ready-to-host
`.well-known/csaf/<tlp>/<year>/` tree. Signing has two paths. `--gpg-key` runs
`gpg --armor --detach-sign` with a key that stays in the gpg keyring (the same
shape as the release-tarball signature). `--key-file` loads an ASCII-armored
secret with `pgpy` for a test that has no keyring. If neither is given the
tree is built unsigned (hashes + metadata only). `SOURCE_DATE_EPOCH` pins
timestamps.

Pure stdlib. The CSAF filename convention is applied: the tracking id,
lowercased, with every char outside [+\\-a-z0-9] replaced by '_', plus '.json'.
"""

import argparse
import csv
import datetime as _dt
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys

_CANON_STRIP = re.compile(r'[^+\-a-z0-9]')
# Short key id (8), long key id (16), or fingerprint (40). No free-form
# user id: the value is passed to gpg as --default-key.
_GPG_KEY_RE = re.compile(r'^(?:0x)?[0-9A-Fa-f]{8,40}$')


def canonical_filename(tracking_id):
    """CSAF recommended filename for a document tracking id."""
    return _CANON_STRIP.sub('_', tracking_id.lower()) + '.json'


def build_timestamp():
    """ISO-8601-Z timestamp; honors SOURCE_DATE_EPOCH for reproducibility."""
    sde = os.environ.get('SOURCE_DATE_EPOCH', '').strip()
    if sde:
        try:
            dt = _dt.datetime.fromtimestamp(int(sde), tz=_dt.timezone.utc)
            return dt.strftime('%Y-%m-%dT%H:%M:%SZ')
        except (ValueError, OverflowError, OSError) as e:
            print(f"WARNING: ignoring invalid SOURCE_DATE_EPOCH={sde!r}: {e}",
                  file=sys.stderr)
    return _dt.datetime.now(_dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def _year_of(doc, timestamp):
    """Distribution sub-folder: year of the initial release date."""
    tr = doc.get('document', {}).get('tracking', {})
    date = tr.get('initial_release_date') or tr.get('current_release_date') or ''
    m = re.match(r'(\d{4})', date)
    return m.group(1) if m else timestamp[:4]


def _sha_files(path):
    """Write <path>.sha256 and <path>.sha512 in `shasum`-style format."""
    data = path.read_bytes()
    for algo in ('sha256', 'sha512'):
        digest = hashlib.new(algo, data).hexdigest()
        sidecar = path.with_name(path.name + '.' + algo)
        sidecar.write_text(f'{digest}  {path.name}\n')


def _load_key(key_file):
    """Load an OpenPGP secret key (ASCII-armored) with pgpy."""
    import pgpy  # imported lazily so unsigned runs need no dependency
    key, _ = pgpy.PGPKey.from_file(key_file)
    return key


def _sign(path, key):
    """Detached, ASCII-armored OpenPGP signature over the raw file bytes.

    Signs the document bytes directly (an OpenPGP binary-document signature),
    which is what a detached `<file>.asc` must verify against."""
    data = path.read_bytes()
    sig = key.sign(data)
    asc = path.with_name(path.name + '.asc')
    asc.write_text(str(sig))
    return asc


def _key_fingerprint(key):
    return str(key.fingerprint).replace(' ', '')


def _export_pubkey(key, dest):
    dest.write_text(str(key.pubkey))


def validate_gpg_key(key_id):
    """Accept a key id or fingerprint. Reject anything gpg could treat as a flag."""
    if not isinstance(key_id, str) or not _GPG_KEY_RE.fullmatch(key_id):
        sys.exit(f'ERROR: --gpg-key {key_id!r} must be a hex key id or '
                 'fingerprint (for example 5CA29677).')
    return key_id


def parse_gpg_fingerprints(colons_text):
    """Primary fingerprint, then subkey fingerprints, from `gpg --with-colons`."""
    found = []
    for line in colons_text.splitlines():
        if not line.startswith('fpr:'):
            continue
        parts = line.split(':')
        if len(parts) > 9 and parts[9]:
            found.append(parts[9].replace(' ', '').upper())
    return found


def _gpg_fingerprint(key_id):
    result = subprocess.run(
        ['gpg', '--batch', '--with-colons', '--fingerprint', key_id],
        check=False, capture_output=True, text=True)
    if result.returncode != 0:
        err = (result.stderr or result.stdout or '').strip()
        sys.exit(f'ERROR: gpg could not read key {key_id}: {err}')
    found = parse_gpg_fingerprints(result.stdout)
    if not found:
        sys.exit(f'ERROR: gpg printed no fingerprint for {key_id}.')
    return found[0]


def _gpg_export_pubkey(key_id, dest):
    """Public key only. The secret key stays in the gpg keyring."""
    result = subprocess.run(
        ['gpg', '--batch', '--armor', '--export', key_id],
        check=False, capture_output=True)
    if result.returncode != 0 or not result.stdout.startswith(b'-----BEGIN PGP'):
        err = (result.stderr or b'').decode('utf-8', 'replace').strip()
        sys.exit(f'ERROR: gpg --export failed for {key_id}: {err}')
    dest.write_bytes(result.stdout if result.stdout.endswith(b'\n')
                     else result.stdout + b'\n')


def _gpg_detach_sign(key_id, path):
    """Same signature shape as `gpg --armor --default-key KEY --detach-sign FILE`.

    `--yes` skips the overwrite question on a second run. The passphrase
    prompt still comes from gpg. `--batch` is not used, because batch mode
    never asks.
    """
    asc = path.with_name(path.name + '.asc')
    result = subprocess.run(
        ['gpg', '--yes', '--armor', '--default-key', key_id,
         '--detach-sign', '--output', str(asc), str(path)],
        check=False)
    if result.returncode != 0 or not asc.is_file():
        sys.exit(f'ERROR: gpg --detach-sign failed for {path}.')
    return asc


def build_provider_metadata(base_url, publisher, fingerprint, timestamp):
    md = {
        'canonical_url': f'{base_url}/provider-metadata.json',
        'last_updated': timestamp,
        'list_on_CSAF_aggregators': True,
        'metadata_version': '2.0',
        'mirror_on_CSAF_aggregators': True,
        'publisher': publisher,
        'role': 'csaf_trusted_provider' if fingerprint else 'csaf_provider',
        'distributions': [{'directory_url': f'{base_url}/'}],
    }
    if fingerprint:
        md['public_openpgp_keys'] = [{
            'fingerprint': fingerprint,
            'url': f'{base_url}/openpgp-key.asc',
        }]
    return md


def _reset_tree(csaf_root):
    """Drop a previous publish so a re-run cannot leave stale documents."""
    for name in ('index.txt', 'changes.csv', 'provider-metadata.json',
                 'openpgp-key.asc'):
        p = csaf_root / name
        if p.is_file():
            p.unlink()
    for tlp in ('white', 'green', 'amber', 'red'):
        d = csaf_root / tlp
        if d.is_dir():
            shutil.rmtree(d)


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('--docs-dir', default='advisories/out',
                   help='Directory holding generated *.csaf.json documents.')
    p.add_argument('--out-root', default='advisories/publish',
                   help='Distribution root; the .well-known/csaf tree is built here.')
    p.add_argument('--base-url',
                   default='https://www.wolfssl.com/.well-known/csaf',
                   help='Public base URL the tree will be served from.')
    p.add_argument('--tlp', default='white',
                   choices=['white', 'green', 'amber', 'red'],
                   help='TLP label folder for the documents.')
    p.add_argument('--key-file', default=None,
                   help='ASCII-armored OpenPGP secret key (pgpy). '
                        'For a test keyring only. Omit to skip signing.')
    p.add_argument('--gpg-key', default=None,
                   help='gpg key id or fingerprint already in the local '
                        'keyring (for example 5CA29677). Signs with '
                        'gpg --armor --detach-sign. The secret key is not '
                        'exported. Do not combine with --key-file.')
    args = p.parse_args()
    if args.key_file and args.gpg_key:
        sys.exit('ERROR: pass only one of --key-file and --gpg-key.')

    docs_dir = pathlib.Path(args.docs_dir)
    csaf_root = pathlib.Path(args.out_root) / '.well-known' / 'csaf'
    csaf_root.mkdir(parents=True, exist_ok=True)
    _reset_tree(csaf_root)

    timestamp = build_timestamp()

    # signer(path) writes path.asc. None leaves the tree unsigned.
    signer = None
    fingerprint = None
    if args.gpg_key:
        key_id = validate_gpg_key(args.gpg_key)
        fingerprint = _gpg_fingerprint(key_id)
        _gpg_export_pubkey(key_id, csaf_root / 'openpgp-key.asc')

        def signer(path, key_id=key_id):
            _gpg_detach_sign(key_id, path)
    elif args.key_file:
        key = _load_key(args.key_file)
        fingerprint = _key_fingerprint(key)
        _export_pubkey(key, csaf_root / 'openpgp-key.asc')

        def signer(path, key=key):
            _sign(path, key)

    index_lines = []
    changes_rows = []
    publisher = None
    used_names = {}

    csaf_docs = sorted(docs_dir.glob('*.csaf.json'))
    if not csaf_docs:
        sys.exit(f'ERROR: no *.csaf.json in {docs_dir}')

    for src in csaf_docs:
        doc = json.loads(src.read_text())
        publisher = publisher or doc['document']['publisher']
        tracking_id = doc['document']['tracking']['id']
        year = _year_of(doc, timestamp)
        rel_dir = pathlib.Path(args.tlp) / year
        dest_dir = csaf_root / rel_dir
        dest_dir.mkdir(parents=True, exist_ok=True)

        dest = dest_dir / canonical_filename(tracking_id)
        if dest.name in used_names:
            sys.exit(
                f'ERROR: tracking ids {used_names[dest.name]!r} and '
                f'{tracking_id!r} both canonicalize to {dest.name}')
        used_names[dest.name] = tracking_id
        rel = (rel_dir / dest.name).as_posix()
        # Point the in-document `self` URL at the hosted path *before* hashing
        # and signing, so the published bytes match the canonical location.
        public_url = args.base_url.rstrip('/') + '/' + rel
        for ref in doc.get('document', {}).get('references', []):
            if ref.get('category') == 'self':
                ref['url'] = public_url
        dest.write_text(json.dumps(doc, indent=2) + '\n')

        _sha_files(dest)
        if signer is not None:
            signer(dest)

        index_lines.append(rel)
        released = doc['document']['tracking'].get('current_release_date', timestamp)
        changes_rows.append((rel, released))

    # index.txt
    (csaf_root / 'index.txt').write_text('\n'.join(index_lines) + '\n')

    # changes.csv (newest first)
    changes_rows.sort(key=lambda r: r[1], reverse=True)
    with (csaf_root / 'changes.csv').open('w', newline='') as fh:
        w = csv.writer(fh)
        for rel, ts in changes_rows:
            w.writerow([rel, ts])

    # provider-metadata.json is hashed (and signed when a key is given).
    md = build_provider_metadata(args.base_url, publisher, fingerprint, timestamp)
    md_path = csaf_root / 'provider-metadata.json'
    md_path.write_text(json.dumps(md, indent=2) + '\n')
    _sha_files(md_path)
    if signer is not None:
        signer(md_path)

    signed = 'signed' if signer is not None else 'UNSIGNED'
    print(f'Published {len(csaf_docs)} CSAF document(s) [{signed}] to {csaf_root}')
    if fingerprint:
        print(f'Signing key fingerprint: {fingerprint}')


if __name__ == '__main__':
    main()
