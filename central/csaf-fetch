#!/usr/bin/env python3
"""Download a published CSAF directory listed by index.txt.

The distribution folder URL often returns 403. This tool does not list
that folder. It fetches provider-metadata.json, index.txt, changes.csv,
each path in index.txt, and the sha256 and sha512 sidecar for each
document and for provider-metadata.json.

It does not fetch .asc files. An unsigned tree (role csaf_provider) has
none. csaf-verify checks signatures only when --fingerprint is passed.

Pure stdlib.
"""

import argparse
import pathlib
import sys
import urllib.error
import urllib.request


class FetchError(Exception):
    """A listed file is missing, or an index path is not safe to write."""


def safe_rel(rel):
    """Return a relative index path, or None for a blank or comment line.

    Reject absolute paths and any '..' segment so a remote index cannot
    write outside the output directory.
    """
    line = rel.strip()
    if not line or line.startswith('#'):
        return None
    if '\\' in line or line.startswith('/') or '://' in line:
        raise FetchError(f'index path is not relative: {line}')
    parts = pathlib.PurePosixPath(line).parts
    if not parts or any(p in ('', '.', '..') for p in parts):
        raise FetchError(f'index path is not relative: {line}')
    return line


def _get(base, rel, timeout):
    url = base + rel
    req = urllib.request.Request(url, headers={'User-Agent': 'wolfglass-csaf-fetch'})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status != 200:
                raise FetchError(f'{url} returned {resp.status}')
            return resp.read()
    except urllib.error.HTTPError as e:
        raise FetchError(f'{url} returned {e.code}') from e
    except urllib.error.URLError as e:
        raise FetchError(f'{url}: {e.reason}') from e


def _write(out, rel, data):
    dest = (out / rel).resolve()
    root = out.resolve()
    if dest != root and root not in dest.parents:
        raise FetchError(f'refusing to write outside {out}: {rel}')
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(data)


def fetch_tree(base_url, out_dir, timeout=60):
    """Download the provider tree into out_dir. Return the index path count."""
    base = base_url.strip().rstrip('/') + '/'
    out = pathlib.Path(out_dir)
    out.mkdir(parents=True, exist_ok=True)

    def pull(rel):
        _write(out, rel, _get(base, rel, timeout))

    pull('provider-metadata.json')
    index_bytes = _get(base, 'index.txt', timeout)
    _write(out, 'index.txt', index_bytes)
    pull('changes.csv')
    for algo in ('sha256', 'sha512'):
        pull(f'provider-metadata.json.{algo}')

    count = 0
    for line in index_bytes.decode('utf-8').splitlines():
        rel = safe_rel(line)
        if rel is None:
            continue
        pull(rel)
        for algo in ('sha256', 'sha512'):
            pull(f'{rel}.{algo}')
        count += 1
    if count == 0:
        raise FetchError('index.txt is empty')
    return count


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('--url', default='https://www.wolfssl.com/.well-known/csaf',
                   help='CSAF distribution URL, without a trailing file name.')
    p.add_argument('--out', required=True,
                   help='Directory to write. Created if missing.')
    p.add_argument('--timeout', type=int, default=60,
                   help='Per-request timeout in seconds.')
    args = p.parse_args(argv)
    try:
        n = fetch_tree(args.url, args.out, timeout=args.timeout)
    except FetchError as e:
        sys.exit(f'ERROR: {e}')
    print(f'OK: fetched {n} document(s) into {args.out}')
    return 0


if __name__ == '__main__':
    main()
